rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'amritanshutiwari3005@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Users & profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        isAdmin() || 
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isAdmin();
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }

    // Inspections
    match /inspections/{inspectionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(inspectionId);
      allow update: if isSignedIn() && isValidId(inspectionId);
      allow delete: if isAdmin();

      // Multi-Product Subcollection
      match /products/{productId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && isValidId(productId);

        // Evidence Subcollection (Scoped strictly under product)
        match /evidence/{evidenceId} {
          allow read: if isSignedIn();
          allow create, update, delete: if isSignedIn() && isValidId(evidenceId);
        }
      }

      // Findings Subcollection
      match /findings/{findingId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && isValidId(findingId);
      }

      // Audit Events (Immutable - strictly append-only)
      match /audit_events/{eventId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(eventId);
        allow update, delete: if false;
      }
    }
  }
}
